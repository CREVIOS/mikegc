{
    "display_information": {
        "name": "MikeGC",
        "description": "Mention @MikeGC to send a message or thread to Legal as an intake request.",
        "background_color": "#1f2937"
    },
    "features": {
        "bot_user": {
            "display_name": "MikeGC",
            "always_online": true
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "app_mentions:read",
                "channels:history",
                "groups:history",
                "chat:write",
                "files:read",
                "users:read",
                "users:read.email"
            ]
        }
    },
    "settings": {
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}
